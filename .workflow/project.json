{
  "name": "tidewatch",
  "version": 1,
  "profiles": {
    "python": [
      {"name": "unit-tests", "argv": [".venv/bin/python", "-m", "pytest", "-q", "-m", "not integration"], "timeout": 300}
    ],
    "integration": [
      {"name": "integration-tests", "argv": [".venv/bin/python", "-m", "pytest", "-q", "-m", "integration"], "timeout": 600}
    ]
  },
  "notes": "先 uv sync 建立 .venv。python profile 不需要 ClickHouse；integration profile 需要先 docker compose up -d。未选中任何测试时 pytest 以 5 退出，不会误报通过。"
}
